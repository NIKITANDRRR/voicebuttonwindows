# VoiceButton — per-machine config (optional).
# Copy to voicebutton.ini next to voicebutton.py (or next to the exe)
# and uncomment what you want to override. Missing keys = code defaults
# (medium model, auto GPU detect, Russian, F9/F10, system default mic).
# voicebutton.ini itself is gitignored — each machine keeps its own.

[model]
# size = medium          ; tiny / base / small / medium / large-v2 / large-v3
# device = auto          ; auto (detect GPU) / cuda / cpu
# compute = auto         ; auto (int8_float16 on GPU, int8 on CPU) / float16 / int8 ...
# beam = 5               ; 1 = fastest, 5 = most accurate
# language = ru          ; ru / auto
# cache_dir =            ; empty = HuggingFace default

[audio]
# mic =                  ; empty = system default input (works on any PC);
                         ; or substring of the device name, e.g. mic = Jabra
                         ; (selectable from the tray "Microphone" menu too)

[hotkeys]
# ptt = f9               ; hold to record
# continuous = f10       ; press once to toggle continuous recording
# history = f8           ; paste from history (each press goes one step back)
# history_size = 10      ; number of recent dictations kept

[prompt]
# Punctuation sample + terms are combined into Whisper's initial prompt (~224 tokens).
# initial_prompt = Привет, как дела? Это пример текста с запятыми, точками и вопросительными знаками.
# terms = Метраникс, Метран, ПГ Метран, КМ, ЧЗ, ТФВС, САКВ, ФИО, артикул

[feedback]
# sound = true           ; beep on record start (880) / stop (440)
# overlay = true         ; mic level bar bottom-right while recording
